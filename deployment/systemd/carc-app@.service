[Unit]
Description=CARC Next.js application (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=webadmins
WorkingDirectory=/var/www/carc-app
Environment=NODE_ENV=production
EnvironmentFile=/var/www/carc-app/.env
ExecStart=/usr/bin/npm run start --workspace=frontend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
