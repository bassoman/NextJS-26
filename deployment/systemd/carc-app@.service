[Unit]
Description=CARC Next.js application (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/NextJS-26
Environment=NODE_ENV=production
EnvironmentFile=/etc/carc/%i.env
ExecStart=/usr/bin/npm run start --workspace=frontend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
