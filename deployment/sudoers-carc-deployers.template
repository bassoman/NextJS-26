# carc-deployers sudoers configuration
# This file is auto-generated by setup-deployment-users.sh
# Manually edit only if you know what you're doing; validate with `sudo visudo -c -f /etc/sudoers.d/carc-deployers`

# Allow deployers group to manage CARC systemd services without password
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart carc-app@prod
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart carc-app@sandbox
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl status carc-app@prod
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl status carc-app@sandbox
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop carc-app@prod
%deployers ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop carc-app@sandbox

# Allow deployers to view application logs
%deployers ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u carc-app@prod *
%deployers ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u carc-app@sandbox *
%deployers ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u carc-backup.service *
%deployers ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u carc-backup.timer *

# Allow deployers to interact with databases (e.g., for manual queries or exports)
%deployers ALL=(ALL) NOPASSWD: /usr/bin/sqlite3 /var/carc/prod/data/carc.db
%deployers ALL=(ALL) NOPASSWD: /usr/bin/sqlite3 /var/carc/sandbox/data/carc.db

# Allow deployers to run backup scripts
%deployers ALL=(ALL) NOPASSWD: /usr/bin/bash /var/www/carc-app/frontend/scripts/backup-sqlite.sh
