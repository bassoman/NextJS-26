# Copy to deployment/nginx.env (gitignored) and edit. Real env vars override these.
DOMAIN=example.com
EMAIL=you@example.com
# 1 = also serve www.DOMAIN (redirects to DOMAIN) and include it in the certificate
WWW_ALIAS=1
# Directory of the app checkout on the server
APP_DIR=/home/ubuntu/NextJS-26
APP_PORT=3000
SITE_NAME=carc
CLIENT_MAX_BODY_SIZE=10m
# ENABLE_HTTPS=1
# CERTBOT_STAGING=1
