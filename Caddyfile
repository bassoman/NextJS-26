{
    # Global options
    email {$ACME_EMAIL:admin@coastsidearc.org}
}

# Domain configuration with automatic Let's Encrypt / ZeroSSL TLS certificates
{$DOMAIN_NAME:coastsidearc.org}, {$WWW_DOMAIN_NAME:www.coastsidearc.org} {
    # Encode responses with gzip and zstd
    encode zstd gzip

    # Serve the app under an optional path prefix (e.g. "/carc"). Empty = root (prod).
    # The prefix is NOT stripped: Next.js has the same prefix baked in via basePath.
    handle {$BASE_PATH:}* {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output stdout
        format console
    }
}
